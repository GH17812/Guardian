<Window x:Class="Guardian.App.Views.DisplayPrivacyCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.DisplayPrivacyCheckTitle}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5">

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="{DynamicResource Str.DisplayPrivacyCheckMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" LineHeight="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Str.Cancel}" IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.DisplayPrivacyCheckAcknowledge}"
                    Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
