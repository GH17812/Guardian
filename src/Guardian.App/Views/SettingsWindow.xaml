<Window x:Class="Guardian.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.SettingsTitle}"
        Width="640" Height="680" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str.SettingsTitle}" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 组一：应用 -->
                <TextBlock Text="{DynamicResource Str.GroupApp}" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.LanguageLabel}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}"
                                      SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Str.LanguageChinese}" />
                                <ComboBoxItem Content="{DynamicResource Str.LanguageEnglish}" />
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ThemeLabel}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}"
                                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Str.ThemeLight}" />
                                <ComboBoxItem Content="{DynamicResource Str.ThemeDark}" />
                                <ComboBoxItem Content="{DynamicResource Str.ThemeSystem}" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 组二：保护服务 -->
                <TextBlock Text="{DynamicResource Str.GroupService}" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.EmergencyHotkeyKey}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{DynamicResource Str.EmergencyHotkeyNote}" FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}" VerticalAlignment="Center"
                                      SelectedValue="{Binding EmergencyHotkeyKey}" SelectedValuePath="Content">
                                <ComboBoxItem Content="F8" />
                                <ComboBoxItem Content="F9" />
                                <ComboBoxItem Content="F10" />
                                <ComboBoxItem Content="F11" />
                                <ComboBoxItem Content="F12" />
                                <ComboBoxItem Content="Pause" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.UiLossAction}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}"
                                      SelectedIndex="{Binding UiLossActionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Str.UiLossRecover}" />
                                <ComboBoxItem Content="{DynamicResource Str.UiLossKeep}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ResumePolicy}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}"
                                      SelectedIndex="{Binding ResumePolicyIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Str.ResumeRestore}" />
                                <ComboBoxItem Content="{DynamicResource Str.ResumeLast}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ClientLostThreshold}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource GuardianTextBox}"
                                     Text="{Binding ClientLostThresholdSeconds}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.OnlyOnAcPower}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <CheckBox Grid.Column="1" Style="{StaticResource GuardianCheckBox}"
                                      IsChecked="{Binding OnlyOnAcPower}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.MaxManualProtection}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            <TextBox Grid.Column="1" Style="{StaticResource GuardianTextBox}"
                                     Text="{Binding MaxManualProtectionMinutes}" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.AllowIsolationRemote}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Str.AllowIsolationRemoteWarning}" FontSize="11.5"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource GuardianCheckBox}"
                                      IsChecked="{Binding AllowIsolationDuringRemoteSession}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.LogLevel}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <ComboBox Grid.Column="1" Style="{StaticResource GuardianComboBox}"
                                      SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Str.LogTrace}" />
                                <ComboBoxItem Content="{DynamicResource Str.LogDebug}" />
                                <ComboBoxItem Content="{DynamicResource Str.LogInformation}" />
                                <ComboBoxItem Content="{DynamicResource Str.LogWarning}" />
                                <ComboBoxItem Content="{DynamicResource Str.LogError}" />
                                <ComboBoxItem Content="{DynamicResource Str.LogCritical}" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.EnvOfflineDir}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{DynamicResource Str.EnvOfflineDirNote}" FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{StaticResource GuardianTextBox}"
                                     VerticalAlignment="Center"
                                     Text="{Binding StreamingEnvOfflineDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Str.Cancel}"
                    Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Save}"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
