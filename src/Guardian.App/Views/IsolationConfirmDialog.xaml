<Window x:Class="Guardian.App.Views.IsolationConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.IsolationConfirmTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5">

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="{DynamicResource Str.IsolationRiskIntro}" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" Margin="0,0,0,12" />

        <Border Style="{StaticResource Card}" Padding="16" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.IsolationRisk1}" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str.IsolationRisk2}" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str.IsolationRisk3}" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" />
            </StackPanel>
        </Border>

        <Border x:Name="RemoteWarning" Background="{DynamicResource DangerFillBrush}" CornerRadius="10" Padding="12"
                Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Str.IsolationRiskRemote}" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>

        <CheckBox x:Name="AcknowledgeCheck" Style="{StaticResource GuardianCheckBox}"
                  Content="{DynamicResource Str.IsolationAcknowledge}" Margin="0,18,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Str.Cancel}" IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Confirm}" Click="OnConfirm"
                    IsEnabled="{Binding ElementName=AcknowledgeCheck, Path=IsChecked}" />
        </StackPanel>
    </StackPanel>
</Window>
