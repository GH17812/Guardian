<Window x:Class="Guardian.App.Views.CreateSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.CreateSessionTitle}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5">

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="{DynamicResource Str.SessionNamePlaceholder}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12.5" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Style="{StaticResource GuardianTextBox}" />

        <TextBlock Text="{DynamicResource Str.WorkloadTypeLabel}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12.5" Margin="0,14,0,6" />
        <ComboBox x:Name="WorkloadCombo" Style="{StaticResource GuardianComboBox}" SelectedIndex="0">
            <ComboBoxItem Content="{DynamicResource Str.WorkloadRemoteDesktop}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadAiAgent}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadRpaAutomation}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadCompilation}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadRendering}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadLocalInference}" />
            <ComboBoxItem Content="{DynamicResource Str.WorkloadOther}" />
        </ComboBox>

        <TextBlock Text="{DynamicResource Str.RequiredModeLabel}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12.5" Margin="0,14,0,6" />
        <ComboBox x:Name="ModeCombo" Style="{StaticResource GuardianComboBox}" SelectedIndex="0">
            <ComboBoxItem Content="{DynamicResource Str.ModePrivacy}" />
            <ComboBoxItem Content="{DynamicResource Str.ModeInputIsolation}" />
        </ComboBox>

        <TextBlock Text="{DynamicResource Str.SourceLabel}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12.5" Margin="0,14,0,6" />
        <ComboBox x:Name="SourceCombo" Style="{StaticResource GuardianComboBox}" SelectedIndex="0">
            <ComboBoxItem Content="{DynamicResource Str.SourceManual}" />
            <ComboBoxItem Content="{DynamicResource Str.SourceExternal}" />
            <ComboBoxItem Content="{DynamicResource Str.SourceAutoDetected}" />
        </ComboBox>

        <TextBlock Text="{DynamicResource Str.MaxDurationLabel}" Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="12.5" Margin="0,14,0,6" />
        <TextBox x:Name="MaxDurationBox" Style="{StaticResource GuardianTextBox}" />

        <CheckBox x:Name="AllowAutoEndCheck" Style="{StaticResource GuardianCheckBox}"
                  Content="{DynamicResource Str.AllowAutoEnd}" IsChecked="True" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Str.Cancel}" IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Confirm}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
