<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：仅颜色与画刷资源。 -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5EA" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0071E3" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#1A0A84FF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="SuccessFillBrush" Color="#2034C759" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E02D25" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#1AFF3B30" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FF9500" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D6" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EBEBF0" />

    <SolidColorBrush x:Key="DisabledBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#AEAEB2" />

    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#E5E5EA" />

</ResourceDictionary>
