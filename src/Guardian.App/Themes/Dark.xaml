<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：仅颜色与画刷资源。 -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3C" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#98989D" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B9CFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#220A84FF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="SuccessFillBrush" Color="#2234C759" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerFillBrush" Color="#22FF3B30" />

    <SolidColorBrush x:Key="WarningBrush" Color="#FF9500" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#48484A" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3C" />

    <SolidColorBrush x:Key="DisabledBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#636366" />

    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#3A3A3C" />

</ResourceDictionary>
